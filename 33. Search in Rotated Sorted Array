class Solution {
public:
    int search(vector<int>& arr, int target) {
        int n = arr.size();
        int low = 0;
        int high = n - 1;
      

        while (low <= high) {
            int guess = (low + high) / 2;

            if (arr[guess] == target) {
                return guess;
            }

            if (arr[guess] > arr[n - 1]) { // first part

             

                    if (arr[guess] < target) {
                        low = guess + 1;
                    }

                 else {
                    
                    if (target < arr[0]) {
                        // move to right
                        low = guess + 1;
                    } else {
                        // move to left
                        high = guess - 1;
                    }
                }

            }
            
            // part 2
            else{

                if (arr[guess] < target) {

                    if (arr[n - 1] < target) {
                        // Move to left
                        high = guess - 1;
                    } else {
                        // move to right
                        low = guess + 1;
                    }

                } else {
                    // move to left
                    high = guess - 1;
                }
            }
             
        }
          return -1;   
        }

       
    
};
