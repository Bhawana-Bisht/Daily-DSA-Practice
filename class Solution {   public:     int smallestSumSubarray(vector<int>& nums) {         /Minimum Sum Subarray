class Solution {
  public:
    int smallestSumSubarray(vector<int>& nums) {
        // Code here
       
         int i =0;
        int  bestending = nums[0];
        int ans= nums[0];
        int n=nums.size();
         for(int i =1;i<n; i++){
            int v1= bestending+ nums[i];
              int v2= nums[i];
            bestending= min(v1,v2);
              ans= min(ans,bestending);
         }
          return  ans;
    }

};
