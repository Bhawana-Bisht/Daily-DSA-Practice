class Solution {
public:
 int findMax(vector<int>&a){
  int maxCount=0;
  for(int i =0; i<256;i++){
     maxCount =max(maxCount,a[i]);}
      return maxCount;
  }
    int characterReplacement(string s, int k)
     {
        vector<int> f(256,0);
        int low= 0;
         int high=0;
         int res=0;
        
         int n= s.size();
         for( int high=0; high< n;high++){
            f[s[high]]++;
            int maxCount= findMax(f);
             int len = high- low+1;
    
             int diff= len - maxCount;
         
          while(diff> k){
           f[s[low]]--;
           low++;
         
           len= high- low+1;
            maxCount= findMax(f);
            diff= len-findMax(f);
          }
           
             res=  max(res,len);
          
    }
     return res;
    }
};
