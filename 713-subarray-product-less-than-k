class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k)

     {
        // to solve when prod=1 ans k=1 so prod/k=1 num[1] do not exist
         if(k <= 1) return 0;
        int low=0; 
        int high=0;
        int n= nums.size();
        int prod=1;
         int res=0;
       
        for(high=0; high<n; high++){
            prod= prod*nums[high];
        while(prod>=k){
         prod= prod/nums[low];
         low++;
          
        }
          res += high- low+ 1;
        }
         return res;
    }


        
    
};
