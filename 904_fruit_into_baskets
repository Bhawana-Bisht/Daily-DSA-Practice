class Solution {
public:
    int totalFruit(vector<int>& fruits) {

        int low = 0;
        int res = INT_MIN;

        unordered_map<int, int> f;

        for (int high = 0; high < fruits.size(); high++) {

            f[fruits[high]]++;

            while (f.size() > 2) {
                f[fruits[low]]--;

                if (f[fruits[low]] == 0)
                    f.erase(fruits[low]);

                low++;
            }

            res = max(res, high - low + 1);
        }

        return res;
    }
};
