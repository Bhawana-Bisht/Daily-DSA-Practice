class Solution {
public:
    int search(vector<int>& arr, int target) {
         int n=arr.size();
        int  low=0;
        int high= n-1;
         while(low<=high){
            // find guess value
            int guess=  high+ low/2;
             if( arr[guess]== target){
                 return guess;
             }
              if( arr[guess]< target){
                // less  value then guess
                 low= guess+ 1;
              }
              else{
                 // high value then guess
                  high= guess-1;
              }
         }
          return -1;
        
    }
};
