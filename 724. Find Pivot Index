class Solution {
public:
    int pivotIndex(vector<int>& arr) {
        int i=0;
       int left=0;
       int n=arr.size();
         int sum = 0;
         for(i=0;i<n;i++)
            sum +=arr[i];
         
         for(int i=0;i<n;i++){
         
          int  right = sum- arr[i]-left;
            if(left== right){
                return i ;
                }
              left += arr[i];
                 
            

         }
          return -1;
         }
    
};
