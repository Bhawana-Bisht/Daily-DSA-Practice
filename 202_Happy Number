class Solution {
public:
int fun(int n){
       int sum=0;
     while(n>0){
    int d= n%10; //give last digit
     n= n/10;// remove last digit
      sum+= d*d;   // give  sum of square of digit
     }
      return sum;
}
    bool isHappy(int n) {
        int fast=n;
        int slow= n;
         while(fast!=1)
         {
       slow= fun(slow);
          fast= fun(fast);
          fast= fun(fast);
          if(slow== fast  && slow!=1){
          return false;
          }}
          return true;
    }
};
