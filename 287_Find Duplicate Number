class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        //  solving by slow-fast 
        int slow= 0; 
        int  fast=0;
          while(true){
             slow= nums[slow];// slow run one times
             fast= nums[fast];// fast run two times 
             fast= nums[fast];
             if(slow == fast){
                 slow= 0;
                 while(slow!= fast){
                    slow= nums[slow];
                    fast= nums[fast];
                 }
                 return    slow;
             }
                
          }
          return   -1;
    }
};
